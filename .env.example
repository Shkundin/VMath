# VisualMath monorepo environment example
# Copy this file to .env for local backend development.

PORT=8787
NODE_ENV=development
APP_URL=http://localhost:8787
API_BASE_URL=http://localhost:8787/api/v1
TRUST_PROXY=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Optional legacy Supabase values. The backend no longer requires them
# unless you still use Supabase-specific integrations elsewhere.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key

# Backend social auth
GOOGLE_OAUTH_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com
VK_APP_ID=your-vk-app-id
# Optional: allow several VK ID apps without breaking existing web/mobile clients.
# Example: VK_APP_IDS=old-web-vk-app-id,new-android-vk-app-id
VK_APP_IDS=
VK_ANDROID_APP_ID=

CORS_ORIGIN=http://localhost:19006,http://127.0.0.1:19006,http://localhost:3000
WS_CORS_ORIGIN=http://localhost:19006,http://127.0.0.1:19006,http://localhost:3000

# Optional client examples
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_WS_URL=ws://localhost:8787/ws
EXPO_PUBLIC_VM_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_VM_WS_URL=ws://localhost:8787/ws
# Production example for a Vercel frontend + Render backend:
# EXPO_PUBLIC_VM_API_BASE_URL=https://vmath.onrender.com
# EXPO_PUBLIC_VM_WS_URL=wss://vmath.onrender.com/ws
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_VK_APP_ID=your-vk-app-id
