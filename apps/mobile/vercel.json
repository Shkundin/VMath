{
  "buildCommand": "pnpm exec expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://vmath.onrender.com/api/v1/:path*"
    },
    {
      "source": "/auth/google",
      "destination": "/"
    },
    {
      "source": "/auth/vk",
      "destination": "/"
    }
  ]
}
